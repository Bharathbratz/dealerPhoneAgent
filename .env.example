# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ---- Your local server (steps 3-4) ----
# Shared secret VAPI sends as the x-vapi-secret header. Make up any long random
# string; the setup script puts the SAME value on every VAPI tool. Once set, the
# webhook rejects any request that doesn't carry it.
VAPI_SERVER_SECRET=change-me-to-a-long-random-string

# ---- VAPI (step 4: registering tools + assistant via API) ----
# VAPI Dashboard -> Org Settings -> API Keys -> the PRIVATE key.
VAPI_API_KEY=

# The public HTTPS URL of your tunnel (no trailing slash), e.g.
# https://abcd-1234.trycloudflare.com  — the setup script appends /vapi/tool-calls.
PUBLIC_URL=

# ---- ElevenLabs voice (step 2 happens in the VAPI dashboard) ----
# After you add your ElevenLabs API key in VAPI (Provider Keys), pick a voice and
# paste its ElevenLabs voice ID here. Leave the default to use a stock voice.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---- The brain (LLM that decides when to call your tools) ----
# VAPI runs this model. gpt-4o-mini is cheap and reliable for this task. You may
# need to add an OpenAI provider key in VAPI if your plan doesn't bundle it.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
